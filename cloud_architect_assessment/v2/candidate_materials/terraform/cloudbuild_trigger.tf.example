###############################################################################
# Cloud Build trigger — copy to cloudbuild_trigger.tf when repo is connected
#
# Prerequisites:
#   - Cloud Source Repository (this example) OR 2nd-gen GitHub connection
#   - iam_cloudbuild.tf bindings applied for deployer SA
#   - cloudbuild.googleapis.com enabled
###############################################################################

# variable "create_cloudbuild_trigger" {
#   type    = bool
#   default = false
# }
#
# variable "source_repo_name" {
#   description = "Cloud Source Repositories name (Option B in cloudbuild/TRIGGER.md)"
#   type        = string
#   default     = "intern-tech-assessment"
# }
#
# resource "google_cloudbuild_trigger" "deploy_frontend" {
#   count       = var.create_cloudbuild_trigger ? 1 : 0
#   project     = var.project_id
#   location    = var.region
#   name        = "${var.client_slug}-webapp-deploy"
#   description = "Build and deploy ${var.client_id} frontend on push to main"
#
#   # Cloud Source Repositories (1st gen trigger style)
#   trigger_template {
#     project_id  = var.project_id
#     repo_name   = var.source_repo_name
#     branch_name = "main"
#     dir         = "" # repo root contains cloudbuild/ and frontend/
#   }
#
#   filename = "cloudbuild/cloudbuild.yaml"
#
#   substitutions = {
#     _PROJECT_ID   = var.project_id
#     _REGION       = var.region
#     _REPOSITORY   = google_artifact_registry_repository.images.repository_id
#     _SERVICE_NAME = google_cloud_run_v2_service.app.name
#     _APP_GREETING = "Hello from Trigger"
#     _CLIENT_ID    = var.client_id
#     _RUNTIME_SA   = google_service_account.app_runtime.email
#   }
#
#   # Run builds as deployer SA (must have cloudbuild.builds.editor + run deploy perms)
#   service_account = google_service_account.deployer.id
# }
#
# output "cloudbuild_trigger_id" {
#   description = "Trigger resource id"
#   value       = var.create_cloudbuild_trigger ? google_cloudbuild_trigger.deploy_frontend[0].trigger_id : null
# }
